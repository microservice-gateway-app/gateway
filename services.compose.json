{
  "users": {
    "v1": {
      "base_url": "http://user-service:8000",
      "health_check_path": "/health",
      "openapi_path": "/openapi.json",
      "auth": {
        "strategy": "user_login",
        "path": "/tokens",
        "extras": {
          "login_key": "email"
        }
      }
    }
  },
  "projects": {
    "v1": {
      "base_url": "http://project-service:8000",
      "health_check_path": "/health",
      "openapi_path": "/openapi.json",
      "auth": {
        "path": "/tokens",
        "strategy": "service_token_exchange",
        "extras": {}
      }
    }
  }
}